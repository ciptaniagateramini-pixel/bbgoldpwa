{
  "name": "bbgold-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts && node scripts/build-sw.mjs",
    "test": "vitest run --config web/vite.config.ts && php tests/php/run.php",
    "test:unit": "vitest run --config web/vite.config.ts",
    "test:php": "php tests/php/run.php",
    "test:e2e": "node tests/e2e/run.mjs",
    "serve:local": "bash scripts/serve-local.sh"
  },
  "dependencies": {
    "@fontsource/poppins": "5.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
